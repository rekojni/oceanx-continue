# Copy to .env.local. These overrides take precedence over the original .env.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server only. Never add VITE_ to this name or commit the filled .env.local.
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
# Older projects may use SUPABASE_SERVICE_ROLE_KEY instead of SUPABASE_SECRET_KEY.
